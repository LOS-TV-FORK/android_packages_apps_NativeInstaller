package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "NativeInstaller",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.los.tv.installer.xml",
    system_ext_specific: true,
    platform_apis: true,
    static_libs: [
        "setupcompat",
        "setupdesign",
    ],
}

// Install engine: command-line Java program, runs as the installer-watch
// init service (UID 0, genuine root, no su). No shell logic inside.
java_binary {
    name: "installer-engine",
    srcs: ["engine/**/*.java"],
    platform_apis: true,
    main_class: "org.los.tv.installer.engine.Main",
}
